{
  "name": "api-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run gen:api",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:analyze": "vue-tsc && vite build --mode analyze",
    "gen:api": "node scripts/gen-api.js",
    "mock-server": "node server/mock-server.js",
    "demo": "concurrently \"npm run mock-server\" \"npm run dev\""
  },
  "dependencies": {
    "axios": "^1.16.1",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.95.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
